<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- AMBIENTE de cifrado del host de pruebas: usa su PROPIA clave AES, separada de la de la
         app (%APPDATA%\ExperienceHub\Testing\key.dat). No comparte clave con Desarrollo. -->
    <add key="ExperienceHub.Ambiente" value="Testing" />
  </appSettings>
  <connectionStrings>
    <!-- Base de pruebas AISLADA: los tests de integración y el seeder escriben acá, nunca en la base
         de la app (ExperienceHubDB). Se conserva el NOMBRE lógico "ExperienceHubDB" (DAL.Acceso lo busca
         por nombre); solo cambia el catálogo físico a ExperienceHubDB_Test (creada con 00_Instalacion_Completa.sql). -->
    <add name="ExperienceHubDB"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=ExperienceHubDB_Test;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
