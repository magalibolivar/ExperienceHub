@startuml CU_CancelarListaEspera
' Secuencia — Cancelar reserva (reglas 6/7) + promoción de lista de espera (regla 9)
title Cancelar Reserva + Lista de Espera — ExperienceHub

actor Agente
participant "BLL.Reserva" as BLL
participant "DAL.Experiencia" as DEXP
participant "DAL.Reserva" as DRES
participant "DAL.Suscripcion" as DSUS
participant "DAL.ListaEspera" as DLE
database "SQL Server" as DB

Agente -> BLL : Cancelar(reserva, motivo)
BLL -> DEXP : ObtenerPorId(idExperiencia)
DEXP --> BLL : Experiencia (FechaHoraInicio)

note right of BLL
  aTiempo = horasHastaInicio >= 48
  (6) a tiempo → libera cupo + devuelve beneficio
  (7) tardía  → consume beneficio (no libera)
end note

BLL -> DRES : Cancelar(id, exp, lugares, motivo, liberarCupo=aTiempo)
activate DRES
DRES -> DB : BEGIN TRAN
DRES -> DB : UPDATE Reserva SET Estado=Cancelada, Motivo, FechaCancelacion
alt aTiempo
  DRES -> DB : UPDATE Experiencia CupoDisponible += lugares
  DRES -> DB : UPDATE Estado=Programada si estaba Completa
end
DRES -> DB : COMMIT
deactivate DRES

alt aTiempo
  BLL -> DSUS : DecrementarConsumo(idSuscripcion)  '(6) devuelve beneficio
  BLL -> DLE : ObtenerPrimeroEnEspera(idExperiencia)
  DLE --> BLL : entrada (o null)
  opt hay alguien esperando  (regla 9)
    BLL -> DLE : CambiarEstado(entrada, Ofrecido)
    BLL -> BLL : Bitácora negocio (PromocionListaEspera)
  end
end

BLL -> BLL : RegistrarHistorial(CANCELAR) + Bitácora
BLL --> Agente : ok

== Cierre de la regla 9 (el cliente confirma la oferta) ==
Agente -> BLL : ListaEspera.ConfirmarOferta(entrada)
BLL -> BLL : Reserva.CrearReserva(...)  ' consume el cupo liberado
BLL -> DLE : CambiarEstado(entrada, Confirmado)
BLL --> Agente : idReserva nueva
@enduml
