        <mxCell id="note_e" value="&lt;b&gt;Transición del plan&lt;/b&gt;&lt;br&gt;Borrador → Aprobado." style="shape=note;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;size=12;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;spacingTop=3;fontColor=#1F3D14;" parent="1" vertex="1"><mxGeometry x="570.0" y="1442.0" width="220" height="46" as="geometry" /></mxCell>
        <mxCell id="n8" value="Marcar el plan&#10;en ejecución" style="rounded=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8960C;fontSize=11;fontColor=#3D3000;align=center;" parent="1" vertex="1"><mxGeometry x="305.0" y="1586.0" width="210" height="62" as="geometry" /></mxCell>
        <mxCell id="note_f" value="&lt;b&gt;Transición del plan&lt;/b&gt;&lt;br&gt;Aprobado → En ejecución." style="shape=note;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;size=12;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;spacingTop=3;fontColor=#1F3D14;" parent="1" vertex="1"><mxGeometry x="565.0" y="1586.0" width="230" height="46" as="geometry" /></mxCell>
        <mxCell id="n9" value="Ejecutar la recomendación&#10;aprobada" style="rounded=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8960C;fontSize=11;fontColor=#3D3000;align=center;" parent="1" vertex="1"><mxGeometry x="1125.0" y="1742.0" width="210" height="62" as="geometry" /></mxCell>
        <mxCell id="d2" value="¿La acción sugerida&#10;modifica el catálogo?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#6AA54F;fontSize=10.5;fontColor=#1F4214;align=center;" parent="1" vertex="1"><mxGeometry x="1145.0" y="1898.0" width="170" height="96" as="geometry" /></mxCell>
        <mxCell id="n10" value="Aplicar el cambio en el&#10;catálogo de experiencias&#10;u organizadores" style="rounded=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8960C;fontSize=11;fontColor=#3D3000;align=center;" parent="1" vertex="1"><mxGeometry x="875.0" y="2054.0" width="210" height="78" as="geometry" /></mxCell>
        <mxCell id="note_g" value="Reutiliza las operaciones existentes&#10;(BLL.Experiencia / BLL.Organizador)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;size=12;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;spacingTop=3;fontColor=#1F3D14;" parent="1" vertex="1"><mxGeometry x="850.0" y="2198.0" width="260" height="46" as="geometry" /></mxCell>
        <mxCell id="n11" value="Registrar la tarea como&#10;atendida sin modificar&#10;el catálogo" style="rounded=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8960C;fontSize=11;fontColor=#3D3000;align=center;" parent="1" vertex="1"><mxGeometry x="1375.0" y="2054.0" width="210" height="78" as="geometry" /></mxCell>
        <mxCell id="note_h" value="&lt;b&gt;Observación pendiente&lt;/b&gt;&lt;br&gt;El mensaje de confirmación es igual para&#10;ambos caminos: no aclara que esta rama no&#10;modifica el catálogo. Requiere ajustar el&#10;texto de la GUI, no la lógica de negocio." style="shape=note;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;size=12;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;spacingTop=3;fontColor=#1F3D14;" parent="1" vertex="1"><mxGeometry x="1330.0" y="2216.0" width="300" height="78" as="geometry" /></mxCell>
        <mxCell id="n12" value="Marcar la recomendación&#10;como Ejecutada" style="rounded=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8960C;fontSize=11;fontColor=#3D3000;align=center;" parent="1" vertex="1"><mxGeometry x="1125.0" y="2378.0" width="210" height="62" as="geometry" /></mxCell>
        <mxCell id="n13" value="Cerrar el plan&#10;de acción" style="rounded=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8960C;fontSize=11;fontColor=#3D3000;align=center;" parent="1" vertex="1"><mxGeometry x="305.0" y="2522.0" width="210" height="62" as="geometry" /></mxCell>
        <mxCell id="note_i" value="&lt;b&gt;Transición del plan&lt;/b&gt;&lt;br&gt;En ejecución → Cerrado. El snapshot de KPIs &quot;Después&quot;&#10;todavía NO se toma acá: se registra recién al evaluar." style="shape=note;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;size=12;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;spacingTop=3;fontColor=#1F3D14;" parent="1" vertex="1"><mxGeometry x="200.0" y="2630.0" width="420" height="56" as="geometry" /></mxCell>
