        <mxCell id="s1" value="" style="ellipse;fillColor=#262626;strokeColor=#262626;html=1;" parent="1" vertex="1"><mxGeometry x="395.0" y="50" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="note_lim" value="&lt;b&gt;Limitación operativa (auditoría)&lt;/b&gt;&lt;br&gt;El rol &quot;Gerente de Operaciones&quot; existe en BD pero no&#10;tiene usuario demo asignado: hoy solo el Administrador&#10;puede recorrer este circuito completo." style="shape=note;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;size=12;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;spacingTop=3;fontColor=#1F3D14;" parent="1" vertex="1"><mxGeometry x="500.0" y="50" width="360" height="60" as="geometry" /></mxCell>
        <mxCell id="n1" value="Analizar indicadores de&#10;demanda, ocupación y&#10;desempeño" style="rounded=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8960C;fontSize=11;fontColor=#3D3000;align=center;" parent="1" vertex="1"><mxGeometry x="305.0" y="170" width="210" height="78" as="geometry" /></mxCell>
        <mxCell id="note_a" value="&lt;b&gt;Tableros&lt;/b&gt;&lt;br&gt;Resumen ejecutivo, demanda&#10;y capacidad, desempeño y calidad." style="shape=note;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;size=12;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;spacingTop=3;fontColor=#1F3D14;" parent="1" vertex="1"><mxGeometry x="560.0" y="170" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="n2" value="Generar recomendaciones" style="rounded=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8960C;fontSize=11;fontColor=#3D3000;align=center;" parent="1" vertex="1"><mxGeometry x="305.0" y="314.0" width="210" height="62" as="geometry" /></mxCell>
        <mxCell id="note_b" value="&lt;b&gt;Motor de recomendaciones (4 reglas)&lt;/b&gt;&lt;br&gt;Lista de espera alta, ocupación baja,&#10;organizador a revisar, plan subutilizado." style="shape=note;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;size=12;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;spacingTop=3;fontColor=#1F3D14;" parent="1" vertex="1"><mxGeometry x="530.0" y="314.0" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="n3" value="Seleccionar las&#10;recomendaciones a llevar&#10;al plan de acción" style="rounded=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8960C;fontSize=11;fontColor=#3D3000;align=center;" parent="1" vertex="1"><mxGeometry x="305.0" y="446.0" width="210" height="78" as="geometry" /></mxCell>
        <mxCell id="n3b" value="Crear el plan&#10;de acción" style="rounded=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8960C;fontSize=11;fontColor=#3D3000;align=center;" parent="1" vertex="1"><mxGeometry x="305.0" y="620.0" width="210" height="62" as="geometry" /></mxCell>
        <mxCell id="note_plan" value="&lt;b&gt;Transición del plan&lt;/b&gt;&lt;br&gt;Nace en Borrador con todas las&#10;recomendaciones seleccionadas en&#10;estado Pendiente. Snapshot KPIs &quot;Antes&quot;." style="shape=note;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;size=12;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;spacingTop=3;fontColor=#1F3D14;" parent="1" vertex="1"><mxGeometry x="530.0" y="620.0" width="300" height="58" as="geometry" /></mxCell>
        <mxCell id="n4a" value="Revisar una recomendación&#10;del plan" style="rounded=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#B8960C;fontSize=11;fontColor=#3D3000;align=center;" parent="1" vertex="1"><mxGeometry x="305.0" y="770.0" width="210" height="62" as="geometry" /></mxCell>
        <mxCell id="d1" value="¿Aprueba la&#10;recomendación?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#6AA54F;fontSize=10.5;fontColor=#1F4214;align=center;" parent="1" vertex="1"><mxGeometry x="325.0" y="902.0" width="170" height="96" as="geometry" /></mxCell>
