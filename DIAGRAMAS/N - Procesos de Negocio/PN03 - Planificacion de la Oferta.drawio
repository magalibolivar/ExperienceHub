        <mxCell id="note_d" value="Decisión: Aprobada" style="shape=note;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;size=12;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;spacingTop=3;fontColor=#1F3D14;" parent="1" vertex="1"><mxGeometry x="565.0" y="1154.0" width="190" height="36" as="geometry" /></mxCell>
        <mxCell id="note_loop" value="Se repite para cada&#10;recomendación del plan." style="shape=note;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;size=12;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;spacingTop=3;fontColor=#1F3D14;" parent="1" vertex="1"><mxGeometry x="280.0" y="1286.0" width="260" height="40" as="geometry" /></mxCell>
