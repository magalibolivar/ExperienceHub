        <mxCell id="note_k" value="&lt;b&gt;Discrepancia pendiente&lt;/b&gt;&lt;br&gt;La cancelación en cascada no&#10;clasifica cada reserva como &quot;a&#10;tiempo&quot; o &quot;tardía&quot;: el reporte de&#10;Planificación la cuenta como&#10;tardía sin importar la fecha real.&#10;Requiere corregir BLL/DAL." style="shape=note;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;size=12;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;spacingTop=3;fontColor=#1F3D14;" parent="1" vertex="1"><mxGeometry x="1610.0" y="4322.0" width="280" height="110" as="geometry" /></mxCell>
