@startuml
title PN01 - Incorporacion y gestion de la oferta de experiencias
|Coordinador de Experiencias|
start
:Detectar necesidad de nuevas experiencias;
repeat
  :Seleccionar un organizador;
  :Solicitar propuesta al organizador;
  |Organizador (externo)|
  :Elaborar propuesta\n(fecha, cupo, condiciones y precio);
  :Enviar propuesta;
  |Coordinador de Experiencias|
  :Evaluar propuesta;
repeat while (Propuesta conveniente?) is (no) not (si)
:Acordar condiciones de incorporacion;
if (Organizador nuevo?) then (si)
  :Registrar organizador;
else (no)
endif
:Incorporar experiencia a la oferta;
:Publicar experiencia como disponible;
stop
@enduml
