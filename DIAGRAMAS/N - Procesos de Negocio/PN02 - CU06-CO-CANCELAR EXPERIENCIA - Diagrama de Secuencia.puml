@startuml
title CU06-CO-CANCELAR EXPERIENCIA
actor "Coordinador de Experiencias" as Co
participant ":Experiencias" as F
participant ":BLL.Experiencia" as BLL
participant ":DAL.Reserva" as DR
participant ":DAL.Experiencia" as DE
participant ":Servicios.Bitacora" as BIT
database "BD" as DB

autonumber
Co -> F : seleccionar experiencia y cancelarla, indicando un motivo

alt 1.1 no se indica un motivo
  F -> BLL : CancelarExperiencia(modulo, experiencia, motivo)
  BLL --> F : AppException("Es obligatorio ingresar un motivo")
  F --> Co : "Debe indicar un motivo"
else motivo indicado
  F -> BLL : CancelarExperiencia(modulo, experiencia, motivo)
  BLL -> DE : ObtenerPorId(idExperiencia)
  DE -> DB : SELECT Experiencia
  DB --> DE : fila
  DE --> BLL : experiencia

  alt 5.1 la experiencia ya estaba cancelada o ya finalizó
    BLL --> F : AppException (ya_cancelada / cancelar_finalizada)
    F --> Co : informar la situación
  else experiencia cancelable
    BLL -> DR : ObtenerActivasDeExperiencia(idExperiencia)
    DR -> DB : SELECT Reserva WHERE Estado = Confirmada
    DB --> DR : reservas activas

    loop por cada reserva activa
      BLL -> BLL : ResolverSuscripcionADevolver(reserva)
      note right
        Solo devuelve el beneficio si la
        suscripción con la que se reservó
        sigue vigente (regla 2). Si la reserva
        es anterior a PN03 (sin IdSuscripcion),
        no se devuelve a ciegas: queda
        advertencia en la bitácora de negocio.
      end note
      BLL -> BLL : construir historial de cancelación
    end

    BLL -> DE : CancelarEnCascada(idExperiencia, motivo, payload)
    group transacción única
      DE -> DB : UPDATE Reserva (Cancelada) por cada reserva
      DE -> DB : UPDATE Suscripcion (devuelve beneficio) donde corresponde
      DE -> DB : INSERT ReservaHistorial por cada reserva
      DE -> DB : UPDATE ListaEspera (Retirado, MotivoRetiro=CierreExperiencia)
      DE -> DB : UPDATE Experiencia (Estado = Cancelada)
    end

    alt 7.1 no se puede completar la cancelación
      DB --> DE : error
      DE --> BLL : excepción (rollback de toda la transacción)
      BLL --> F : no se pudo cancelar
      F --> Co : informar la situación
    else cancelación exitosa
      DB --> DE : ok
      DE --> BLL : confirmación
      BLL -> BIT : Registrar(bitácora de seguridad + eventos de negocio\npor la experiencia y por cada reserva devuelta)
      BLL --> F : experiencia cancelada
      F --> Co : "Experiencia cancelada correctamente"
    end
  end
end
@enduml
