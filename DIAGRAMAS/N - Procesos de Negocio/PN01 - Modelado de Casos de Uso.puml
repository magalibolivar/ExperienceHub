@startuml PN01 - Modelado de Casos de Uso
left to right direction
skinparam actor {
  BackgroundColor #FBD7A5
  BorderColor #333333
}
skinparam usecase {
  BackgroundColor #D6E4F9
  BorderColor #333333
  FontStyle bold
}
skinparam rectangle {
  BorderColor #333333
}
skinparam ArrowColor #333333
skinparam packageStyle folder

package "uc Procesos de negocio" {
  actor Usuario
  actor "Agente de Reservas" as AG
  actor "Caja" as CA
  Usuario <|-- AG
  Usuario <|-- CA

  rectangle "Agente de Reservas" {
    usecase "CU01-VTA-GESTIONAR SUSCRIPCIÓN" as CU1
    usecase "CU02-VTA-CONSULTAR PLANES" as CU2
    usecase "CU03-VTA-REGISTRAR CLIENTE" as CU3
  }
  rectangle "Caja" {
    usecase "CU01-CAJ-GESTIONAR COBRO" as CU4
    usecase "CU02-CAJ-EMITIR COMPROBANTE" as CU5
    usecase "CU03-CAJ-CANCELAR CONTRATACIÓN" as CU6
  }

  AG --> CU1
  AG --> CU2
  AG --> CU3
  CA --> CU4
  CA --> CU5
  CA --> CU6

  CU1 ..> CU2 : <<include>>
  CU1 ..> CU4 : <<include>>
  CU4 ..> CU5 : <<include>>
  CU6 ..> CU4 : <<extend>>
}
@enduml
