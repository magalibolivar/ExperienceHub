@startuml CU - Clases - Composite Perfiles
title T04 - Gestion de Perfiles (patron Composite)
skinparam classAttributeIconSize 0

abstract class Componente {
  + Id : int
  + Nombre : string
  + {abstract} ObtenerPatentes() : List<Patente>
}
class Patente {
  + ObtenerPatentes() : List<Patente>  ' se devuelve a si misma (hoja)
}
class Rol {
  - hijos : List<Componente>
  + Agregar(c : Componente)
  + Quitar(c : Componente)
  + ObtenerPatentes() : List<Patente>  ' recursivo, con dedup y anti-ciclos
}

Componente <|-- Patente
Componente <|-- Rol
Rol o--> "*" Componente : hijos (rol-en-rol)

class "BLL.Familia" as BF
class "DAL.Permiso" as DP
BF ..> Componente : arma/recorre el arbol
BF ..> DP
DP ..> "Permiso / PermisoRelacion" : persistencia
@enduml
