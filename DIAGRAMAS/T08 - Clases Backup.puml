@startuml T08 - Clases Backup
title T08 - Gestion de Backup y Restauracion
skinparam classAttributeIconSize 0

class "BLL.Backup" {
  + Generar(password) : Archivo
  + GenerarInstalacionLimpia(password)
  + Restaurar(archivo, password)
  + Importar(rutaExterna, password)
  + Eliminar(archivo)
  + Listar() : List<Archivo>
}
class "DAL.Backup" {
  + BACKUP DATABASE
  + RESTORE VERIFYONLY
  + RESTORE ... WITH REPLACE (SINGLE_USER)
}
class "CifradorArchivos\n(Seguridad)" {
  + Cifrar(datos, password)  ' AES-128 + PBKDF2
  + Descifrar(datos, password)
}
class "BLL.Configuracion" {
  + VerificarIntegridad() : bool  ' DVH/DVV
}
class "Servicios.Bitacora"

"BLL.Backup" ..> "BLL.Configuracion" : exige integridad antes de respaldar
"BLL.Backup" ..> "CifradorArchivos\n(Seguridad)"
"BLL.Backup" ..> "DAL.Backup"
"BLL.Backup" ..> "Servicios.Bitacora" : criticidad Alta

note bottom of "BLL.Backup"
  Extension .ehbak, nombre
  ExperienceHub_Backup_yyyyMMddHHmmss_USUARIO.ehbak
  Exclusivo del Administrador.
end note
@enduml
