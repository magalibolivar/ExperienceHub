@startuml DER - Permisos
title DER - Permiso / PermisoRelacion / RolPermiso (arbol Composite persistido)
skinparam linetype ortho
entity "Permiso" as P {
  * IdPermiso : int <<PK>>
  --
  Nombre : nvarchar
  Tipo : int  ' 0=Patente, 1=Rol
}
entity "PermisoRelacion" as PR {
  * IdPadre : int <<PK,FK>>
  * IdHijo : int <<PK,FK>>
}
entity "RolPermiso" as RP {
  * IdRol : int <<PK,FK>>
  * IdPermiso : int <<PK,FK>>
}
entity "ControlMapeado" as CM {
  * IdControl : int <<PK>>
  --
  Nombre : nvarchar
  IdPatente : int <<FK>>
}

P ||--o{ PR : padre (IdPadre)
P ||--o{ PR : hijo  (IdHijo)
P ||--o{ RP
P ||--o{ CM : patente -> control
@enduml
