@startuml CU - Secuencia - Verificacion Integridad
title T07 - Verificacion de Integridad por Digitos Verificadores (fail-closed)
participant "Program / Menu\n(arranque + Timer 30')" as P
participant "BLL.Configuracion" as C
participant "DAL.DigitoVerificador" as D
participant "CalculadorDV\n(Factory)" as CDV
database "SQL Server" as DB
actor "Administrador" as A

P -> C : VerificarIntegridad()
loop por cada tabla protegida\n(Usuario, Cliente, Empleado, Experiencia, Reserva, Organizador)
  C -> D : RecalcularTabla(tabla, pk, columnas)
  D -> DB : SELECT filas
  D -> CDV : CalcularDVH(fila)  ' incluye posicion de caracter/atributo
  D -> CDV : CalcularDVV(tabla)
  D -> DB : comparar con DVH/DVV almacenados
  D --> C : INTEGRO | COMPROMETIDO (filas)
end
alt INTEGRO
  C --> P : continua el arranque / login
else COMPROMETIDO
  C -> DB : registrar en Bitacora + HistorialIntegridad
  C --> P : bloquear acceso (fail-closed) y avisar
  A -> C : Recalcular Todo | Reparar Seleccionadas\n(exige credenciales de Admin)
  C -> D : recalcular / reparar
  C -> DB : actualizar DV
end
@enduml
