@startuml T03 - Clases Encriptado
skinparam class {
  BackgroundColor #FDEEE0-#F6C9A0
  BorderColor #8B4A2B
  FontColor #2B2B40
  ArrowColor #8B4A2B
}
skinparam enum {
  BackgroundColor #FDEEE0-#F6C9A0
  BorderColor #8B4A2B
  FontColor #2B2B40
}
skinparam note {
  BackgroundColor #FFF3C4
  BorderColor #D9A441
}
skinparam package {
  BackgroundColor #FFFCF7
  BorderColor #8B4A2B
  FontColor #2B2B40
}
title T03 - Gestion de Encriptado (clase estatica Encriptador, principio Open/Closed)
skinparam classAttributeIconSize 0

class Encriptador <<static>> {
  + Hash(contrasena : string) : string
  + VerificarContrasena(ingresada, almacenada) : bool
  + VerificacionSenuelo(contrasena) : bool  ' anti-enumeracion (costo constante)
  + ValidarContrasena(contrasena) : (valida, mensaje)
  + Encriptar(texto : string) : string
  + Desencriptar(cifrado : string) : string
  + TryDesencriptar(valor : string) : string
  + ConvertirBase64(data : byte[]) : string
}
note right of Encriptador
  PBKDF2-SHA256 (salt 16B, 100.000 iter, hash 32B)
  para contrasenas de Usuario.
  AES-128-CBC (IV aleatorio por operacion)
  para datos sensibles (DNI del Cliente).
end note

class "BLL.Usuario" as BU
class "DAL.Cliente" as DC

BU ..> Encriptador : Hash / VerificarContrasena
DC ..> Encriptador : Encriptar / TryDesencriptar (DNI)

class DiagnosticoCifrado <<static>> {
  + Clasificar(valor : string, clavesDisponibles : IReadOnlyList<byte[]>) : EstadoDni
  + Huella(clave : byte[]) : string
  + RecuperarClave(rutaKeyDat : string) : byte[]
}
enum EstadoDni {
  Legible
  CifradoConClaveActual
  CifradoConClaveVieja
  Irrecuperable
}
DiagnosticoCifrado ..> EstadoDni
note right of DiagnosticoCifrado
  Utilidad de diagnostico: clasifica un DNI cifrado
  segun con que clave fue encriptado, para detectar
  un key.dat desalineado con los datos. [VERIFICAR]:
  solo tiene tests propios (DiagnosticoCifradoTests);
  no esta invocada desde ninguna pantalla todavia.
end note
@enduml
